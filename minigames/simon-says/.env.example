# Base URL of the Terra Prime instance the game reads from.
TERRA_PRIME_URL=http://localhost:5173

# Session token used for API authentication.
#
# This must come from an ADMIN account: looking a character up by name needs
# GET /api/events and GET /api/characters, both of which are admin-gated. An
# admin login carries both the `admin` and `user` roles, which covers the whole
# lookup chain.
#
# Tokens are UUIDv4, expire after 24 hours, and are invalidated when that
# account logs in again somewhere else -- so this needs refreshing periodically.
#
# Get one by logging in and reading the `session-token` cookie, or:
#   curl -s -X POST http://localhost:5173/api/authentication/login \
#     -H 'content-type: application/json' \
#     -d '{"email":"you@example.com","password":"..."}' | jq -r .token
TERRA_PRIME_TOKEN=00000000-0000-0000-0000-000000000000
