FROM node:24-slim AS base 

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV PNPM_CONFIG_NO_TTY=1
ENV CI=true

RUN corepack enable
COPY . /app
WORKDIR /app


FROM base AS prod-deps
RUN pnpm install --prod --frozen-lockfile

FROM base AS build
ARG VITE_GOOGLE_CLIENT_EMAIL
ARG VITE_GOOGLE_PRIVATE_KEY
ARG VITE_GOOGLE_EMAIL_SUBJECT
ARG PUBLIC_BASE_URL
ARG VITE_GOOGLE_CLIENT_EMAIL=$VITE_GOOGLE_CLIENT_EMAIL
ARG VITE_GOOGLE_PRIVATE_KEY=$VITE_GOOGLE_PRIVATE_KEY
ARG VITE_GOOGLE_EMAIL_SUBJECT=$VITE_GOOGLE_EMAIL_SUBJECT
ARG PUBLIC_BASE_URL=$PUBLIC_BASE_URL
RUN pnpm install  --frozen-lockfile
RUN pnpm run build

FROM base AS dev
RUN pnpm install --frozen-lockfile
EXPOSE 5173
CMD ["pnpm", "host"]

FROM base AS migrate-runner
COPY --from=build /app/node_modules node_modules/
CMD ["pnpm", "migrate"]

FROM base
COPY --from=prod-deps /app/node_modules node_modules/
COPY --from=build /app/build build/
# `PORT` is what `realtime/index.ts` binds; Railway injects it, so this is only the local default.
EXPOSE 3000
# `pnpm start` is adapter-node on its own: no MQTT bridge, no `/api/realtime`, nothing a device or
# the control room can reach. The realtime entrypoint mounts the same SvelteKit handler and starts
# the bridge alongside it, which is the only shape in which this container is actually deployable.
CMD ["sh", "-c", "pnpm migrate && pnpm start:realtime"]

