{
	"name": "testalice-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"host": "npm run dev -- --host 0.0.0.0",
		"start": "node ./build/index.js",
		"start:websocket": "node ./websocket-server",
		"migrate": "tsx db/migrate.ts",
		"seed": "tsx db/seed.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bcrypt": "^5.0.2",
		"@types/node": "^22.20.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.5.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"@google-cloud/local-auth": "^2.1.1",
		"@lucide/svelte": "^1.45.0",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@types/express": "^5.0.6",
		"@types/three": "^0.174.0",
		"@types/ws": "^8.18.1",
		"bcrypt": "^6.0.0",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"googleapis": "^105.0.0",
		"mysql2": "^3.24.4",
		"three": "^0.180.0",
		"tsx": "^4.23.13",
		"uuid": "^11.1.1",
		"ws": "^8.21.3"
	}
}
