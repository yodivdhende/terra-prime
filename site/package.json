{
	"name": "testalice-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"host": "npm run dev -- --host 0.0.0.0",
		"start": "node ./build/index.js",
		"start:websocket": "node ./websocket-server"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@types/bcrypt": "^5.0.2",
		"@types/node": "^22.19.15",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^16.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0",
		"vite": "^6.4.2"
	},
	"dependencies": {
		"@google-cloud/local-auth": "^2.1.1",
		"@lucide/svelte": "^0.501.0",
		"@threlte/core": "^8.5.4",
		"@threlte/extras": "^9.13.3",
		"@types/express": "^5.0.6",
		"@types/three": "^0.174.0",
		"@types/ws": "^8.18.1",
		"bcrypt": "^6.0.0",
		"express": "^5.2.1",
		"googleapis": "^105.0.0",
		"mysql2": "^3.20.0",
		"three": "^0.180.0",
		"uuid": "^11.1.0",
		"ws": "^8.20.0"
	}
}
